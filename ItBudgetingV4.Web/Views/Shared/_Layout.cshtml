<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Budgeting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">IT Budgeting</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Budget" asp-action="Index">Budget Grid</a>
                <a class="nav-link" asp-controller="Versions" asp-action="Index">Versions</a>
                <a class="nav-link" asp-controller="FinancialTransactions" asp-action="Index">Transactions</a>
                <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
                <a class="nav-link" asp-controller="AuditLogs" asp-action="Index">Audit Log</a>
                <a class="nav-link" asp-controller="Import" asp-action="Index">Excel Import</a>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                    <span class="text-muted small">@User.Identity?.Name (@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                </form>
            }
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
