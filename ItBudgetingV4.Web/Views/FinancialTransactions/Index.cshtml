@model List<ItBudgetingV4.Web.Domain.FinancialTransaction>
@{
    ViewData["Title"] = "Financial Transactions";
}

<h2>Financial Transactions</h2>

@if (User.IsInRole("CIO Secretary"))
{
    <form asp-action="Create" method="post" class="row g-2 card card-body mb-3">
        <div class="col-md-3"><select name="BudgetItemId" class="form-select" asp-items="ViewBag.BudgetItems"></select></div>
        <div class="col-md-2"><select name="Type" class="form-select" asp-items="Html.GetEnumSelectList<ItBudgetingV4.Web.Domain.FinancialTransactionType>()"></select></div>
        <div class="col-md-2"><input name="ReferenceNumber" class="form-control" placeholder="Reference" /></div>
        <div class="col-md-2"><input name="Amount" type="number" step="0.01" class="form-control" placeholder="Amount" /></div>
        <div class="col-md-2"><input name="Vendor" class="form-control" placeholder="Vendor" /></div>
        <div class="col-md-1"><button class="btn btn-primary w-100" type="submit">Add</button></div>
    </form>
}

<table class="table table-striped">
    <thead><tr><th>Created</th><th>Type</th><th>Ref</th><th>Amount</th><th>Vendor</th><th>Budget Item</th></tr></thead>
    <tbody>
    @foreach (var tx in Model)
    {
        <tr>
            <td>@tx.CreatedAt.ToString("u")</td>
            <td>@tx.Type</td>
            <td>@tx.ReferenceNumber</td>
            <td>@tx.Amount.ToString("N2")</td>
            <td>@tx.Vendor</td>
            <td>@tx.BudgetItem?.Project</td>
        </tr>
    }
    </tbody>
</table>
